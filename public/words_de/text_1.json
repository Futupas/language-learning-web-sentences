{
  "id": "text_1",
  "metadata": "Source: The Chronicles of Testing - Longform Edition",
  "blocks": [
    {
      "type": "h1",
      "segments": [
        {
          "de": { "text": "Das große Test-Epos", "explanation": "Titel des langen Textes." },
          "en": { "text": "The Great Test Epic", "explanation": "Title of the long text." },
          "uk": { "text": "Великий тестовий епос", "explanation": "Назва довгого тексту." },
          "cs": { "text": "Velký testovací epos", "explanation": "Název dlouhého textu." },
          "ru": { "text": "Великий тестовый эпос", "explanation": "Название длинного текста." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Es war einmal ", "explanation": "Klassischer Märchenanfang." },
          "en": { "text": "Once upon a time ", "explanation": "Classic fairy tale beginning." },
          "uk": { "text": "Одного разу ", "explanation": "Класичний початок казки." },
          "cs": { "text": "Byl jednou ", "explanation": "Klasický začátek pohádky." },
          "ru": { "text": "Жил-был ", "explanation": "Классическое начало сказки." }
        },
        {
          "de": { "text": "ein kleiner Webbrowser, " },
          "en": { "text": "a small web browser, " },
          "uk": { "text": "один маленький веб-браузер, " },
          "cs": { "text": "jeden malý webový prohlížeč, " },
          "ru": { "text": "один маленький веб-браузер, " }
        },
        {
          "de": { "text": "der sehr müde war ", "explanation": "Verwendung des Präteritums von 'sein'." },
          "en": { "text": "that was very tired ", "explanation": "Use of the past tense of 'to be'." },
          "uk": { "text": "який був дуже втомленим ", "explanation": "Використання минулого часу." },
          "cs": { "text": "který byl velmi unavený ", "explanation": "Použití minulého času." },
          "ru": { "text": "который был очень уставшим ", "explanation": "Использование прошедшего времени." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "weil er tausende Zeilen " },
          "en": { "text": "because he had to render " },
          "uk": { "text": "бо він мусив відрендерити " },
          "cs": { "text": "protože musel vykreslit " },
          "ru": { "text": "потому что он должен был отрендерить " }
        },
        {
          "de": { "text": "von unstrukturiertem Code " },
          "en": { "text": "thousands of lines of code " },
          "uk": { "text": "тисячі рядків коду " },
          "cs": { "text": "tisíce řádků kódu " },
          "ru": { "text": "тысячи строк кода " }
        },
        {
          "de": { "text": "rendern musste.", "explanation": "Modalverb 'müssen' im Präteritum am Satzende." },
          "en": { "text": "without crashing.", "explanation": "Modal verb 'must' in past tense at the end." },
          "uk": { "text": "без збоїв.", "explanation": "Модальне дієслово 'мусити' у минулому часі." },
          "cs": { "text": "bez pádu.", "explanation": "Modální sloveso v minulém čase." },
          "ru": { "text": "без сбоев.", "explanation": "Модальный глагол в прошедшем времени." }
        }
      ]
    },
    {
      "type": "h2",
      "segments": [
        {
          "de": { "text": "Kapitel 1: Das scrollende Monster" },
          "en": { "text": "Chapter 1: The Scrolling Monster" },
          "uk": { "text": "Розділ 1: Монстр прокрутки" },
          "cs": { "text": "Kapitola 1: Scrollující monstrum" },
          "ru": { "text": "Глава 1: Прокручивающийся монстр" }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Der Benutzer wollte wissen, " },
          "en": { "text": "The user wanted to know " },
          "uk": { "text": "Користувач хотів знати, " },
          "cs": { "text": "Uživatel chtěl vědět, " },
          "ru": { "text": "Пользователь хотел знать, " }
        },
        {
          "de": { "text": "ob das Scrollen funktioniert. " },
          "en": { "text": "if scrolling works. " },
          "uk": { "text": "чи працює прокручування. " },
          "cs": { "text": "zda scrollování funguje. " },
          "ru": { "text": "работает ли прокрутка. " }
        },
        {
          "de": { "text": "Deshalb scrollte er nach unten und unten ", "explanation": "Wortwiederholung zur Betonung." },
          "en": { "text": "Therefore he scrolled down and down ", "explanation": "Word repetition for emphasis." },
          "uk": { "text": "Тому він крутив вниз і вниз ", "explanation": "Повторення слова для підкреслення." },
          "cs": { "text": "Proto scroloval dolů a dolů ", "explanation": "Opakování slova pro důraz." },
          "ru": { "text": "Поэтому он прокручивал вниз и вниз ", "explanation": "Повторение слова для акцента." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "bis der Bildschirm glühte. " },
          "en": { "text": "until the screen glowed. " },
          "uk": { "text": "поки екран не засяяв. " },
          "cs": { "text": "dokud obrazovka nezářila. " },
          "ru": { "text": "пока экран не засветился. " }
        },
        {
          "de": { "text": "Ein normaler Mensch hätte aufgehört, " },
          "en": { "text": "A normal person would have stopped, " },
          "uk": { "text": "Звичайна людина зупинилася б, " },
          "cs": { "text": "Normální člověk by přestal, " },
          "ru": { "text": "Нормальный человек остановился бы, " }
        },
        {
          "de": { "text": "aber unser Held war kein normaler Mensch.", "explanation": "Negativartikel 'kein'." },
          "en": { "text": "but our hero was no normal person.", "explanation": "Negative article 'no'." },
          "uk": { "text": "але наш герой не був звичайною людиною.", "explanation": "Заперечний артикль." },
          "cs": { "text": "ale náš hrdina nebyl normální člověk.", "explanation": "Záporný člen." },
          "ru": { "text": "но наш герой не был обычным человеком.", "explanation": "Отрицательный артикль." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Er trank Kaffee, " },
          "en": { "text": "He drank coffee, " },
          "uk": { "text": "Він пив каву, " },
          "cs": { "text": "Pil kávu, " },
          "ru": { "text": "Он пил кофе, " }
        },
        {
          "de": { "text": "aß ein Stück Pizza " },
          "en": { "text": "ate a piece of pizza " },
          "uk": { "text": "їв шматок піци " },
          "cs": { "text": "jedl kousek pizzy " },
          "ru": { "text": "ел кусок пиццы " }
        },
        {
          "de": { "text": "und drückte weiter auf die Tasten.", "explanation": "Trennbares Verb 'weiterdrücken'." },
          "en": { "text": "and kept pressing the keys.", "explanation": "Phrasal verb meaning to continue pressing." },
          "uk": { "text": "і продовжував натискати клавіші.", "explanation": "Розділове дієслово продовження дії." },
          "cs": { "text": "a dál mačkal klávesy.", "explanation": "Sloveso vyjadřující pokračování." },
          "ru": { "text": "и продолжал нажимать клавиши.", "explanation": "Глагол, означающий продолжение." }
        }
      ]
    },
    {
      "type": "h2",
      "segments": [
        {
          "de": { "text": "Kapitel 2: Die Absätze der Verzweiflung" },
          "en": { "text": "Chapter 2: The Paragraphs of Despair" },
          "uk": { "text": "Розділ 2: Абзаци розпачу" },
          "cs": { "text": "Kapitola 2: Odstavce zoufalství" },
          "ru": { "text": "Глава 2: Абзацы отчаяния" }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Absatz Nummer sieben ist wichtig, " },
          "en": { "text": "Paragraph number seven is important, " },
          "uk": { "text": "Сьомий абзац важливий, " },
          "cs": { "text": "Odstavec číslo sedm je důležitý, " },
          "ru": { "text": "Седьмой абзац важен, " }
        },
        {
          "de": { "text": "weil ohne ihn die Höhe " },
          "en": { "text": "because without it the height " },
          "uk": { "text": "бо без нього висота " },
          "cs": { "text": "protože bez něj výška " },
          "ru": { "text": "потому что без него высота " }
        },
        {
          "de": { "text": "nicht lang genug wäre.", "explanation": "Konjunktiv II ('wäre' = would be)." },
          "en": { "text": "would not be long enough.", "explanation": "Conditional form 'would be'." },
          "uk": { "text": "не була б достатньо великою.", "explanation": "Умовний спосіб." },
          "cs": { "text": "by nebyla dost dlouhá.", "explanation": "Podmiňovací způsob." },
          "ru": { "text": "не была бы достаточно длинной.", "explanation": "Сослагательное наклонение." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Man fragt sich oft: " },
          "en": { "text": "One often asks oneself: " },
          "uk": { "text": "Люди часто запитують себе: " },
          "cs": { "text": "Člověk se často ptá: " },
          "ru": { "text": "Человек часто спрашивает себя: " }
        },
        {
          "de": { "text": "Warum schreiben Entwickler so viel Text? " },
          "en": { "text": "Why do developers write so much text? " },
          "uk": { "text": "Чому розробники пишуть стільки тексту? " },
          "cs": { "text": "Proč vývojáři píší tolik textu? " },
          "ru": { "text": "Почему разработчики пишут так много текста? " }
        },
        {
          "de": { "text": "Die Antwort ist einfach: Um zu testen.", "explanation": "Infinitivsatz mit 'um ... zu'." },
          "en": { "text": "The answer is simple: To test.", "explanation": "Infinitive clause with 'to'." },
          "uk": { "text": "Відповідь проста: щоб тестувати.", "explanation": "Інфінітивний зворот." },
          "cs": { "text": "Odpověď je jednoduchá: Testovat.", "explanation": "Účelová vazba." },
          "ru": { "text": "Ответ прост: чтобы тестировать.", "explanation": "Инфинитивный оборот." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Jedes Wort in diesem Dokument " },
          "en": { "text": "Every word in this document " },
          "uk": { "text": "Кожне слово в цьому документі " },
          "cs": { "text": "Každé slovo v tomto dokumentu " },
          "ru": { "text": "Каждое слово в этом документе " }
        },
        {
          "de": { "text": "wurde mit Liebe generiert, " },
          "en": { "text": "was generated with love, " },
          "uk": { "text": "було згенеровано з любов'ю, " },
          "cs": { "text": "bylo vygenerováno s láskou, " },
          "ru": { "text": "было сгенерировано с любовью, " }
        },
        {
          "de": { "text": "obwohl es absolut keinen Sinn ergibt.", "explanation": "Konjunktion 'obwohl' (although) verb-final." },
          "en": { "text": "even though it makes zero sense.", "explanation": "Conjunction 'although' putting verbs at the end." },
          "uk": { "text": "хоча воно не має жодного сенсу.", "explanation": "Сполучник 'хоча' відправляє дієслово в кінець." },
          "cs": { "text": "přestože to nedává žádný smysl.", "explanation": "Spojka 'přestože' dává sloveso na konec." },
          "ru": { "text": "хотя в этом нет никакого смысла.", "explanation": "Союз 'хотя' отправляет глагол в конец." }
        }
      ]
    },
    {
      "type": "h2",
      "segments": [
        {
          "de": { "text": "Kapitel 3: Der Sumpf der Erklärungen" },
          "en": { "text": "Chapter 3: The Swamp of Explanations" },
          "uk": { "text": "Розділ 3: Болото пояснень" },
          "cs": { "text": "Kapitola 3: Močál vysvětlení" },
          "ru": { "text": "Глава 3: Болото объяснений" }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Manchmal klickt man auf ein Wort " },
          "en": { "text": "Sometimes you click on a word " },
          "uk": { "text": "Іноді ти клікаєш на слово " },
          "cs": { "text": "Někdy kliknete na slovo " },
          "ru": { "text": "Иногда вы кликаете на слово " }
        },
        {
          "de": { "text": "und denkt sich: 'Was bedeutet das?' " },
          "en": { "text": "and think to yourself: 'What does that mean?' " },
          "uk": { "text": "і думаєш: 'Що це означає?' " },
          "cs": { "text": "a říkáte si: 'Co to znamená?' " },
          "ru": { "text": "и думаете: 'Что это значит?' " }
        },
        {
          "de": { "text": "Und dann erscheint eine magische Box.", "explanation": "Präsens von 'erscheinen' ('appears')." },
          "en": { "text": "And then a magical box appears.", "explanation": "Present tense of 'to appear'." },
          "uk": { "text": "І тоді з'являється магічна коробка.", "explanation": "Теперішній час." },
          "cs": { "text": "A pak se objeví kouzelná krabička.", "explanation": "Přítomný čas." },
          "ru": { "text": "И тогда появляется волшебная коробочка.", "explanation": "Настоящее время." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Das ist der Moment, " },
          "en": { "text": "That is the moment " },
          "uk": { "text": "Це той момент, " },
          "cs": { "text": "To je ten moment, " },
          "ru": { "text": "Это тот момент, " }
        },
        {
          "de": { "text": "in dem das Sprachenlernen Spaß macht. " },
          "en": { "text": "in which learning languages becomes fun. " },
          "uk": { "text": "коли вивчення мов стає веселим. " },
          "cs": { "text": "kdy se učení jazyků stává zábavou. " },
          "ru": { "text": "когда изучение языков становится веселым. " }
        },
        {
          "de": { "text": "Oder auch nicht, je nach Kaffeepegel.", "explanation": "Redewendung 'je nach' (depending on)." },
          "en": { "text": "Or maybe not, depending on caffeine levels.", "explanation": "Idiomatic expression 'depending on'." },
          "uk": { "text": "Або й ні, залежно від рівня кофеїну.", "explanation": "Ідіоматичний вираз." },
          "cs": { "text": "Nebo taky ne, podle hladiny kofeinu.", "explanation": "Idiomatické vyjádření." },
          "ru": { "text": "Или нет, в зависимости от уровня кофеина.", "explanation": "Идиоматическое выражение." }
        }
      ]
    },
    {
      "type": "h2",
      "segments": [
        {
          "de": { "text": "Kapitel 4: Das unendliche Ende" },
          "en": { "text": "Chapter 4: The Infinite End" },
          "uk": { "text": "Розділ 4: Нескінченний кінець" },
          "cs": { "text": "Kapitola 4: Nekonečný konec" },
          "ru": { "text": "Глава 4: Бесконечный конец" }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Wir sind fast am Ziel. " },
          "en": { "text": "We are almost at the goal. " },
          "uk": { "text": "Ми майже біля мети. " },
          "cs": { "text": "Jsme téměř u cíle. " },
          "ru": { "text": "Мы почти у цели. " }
        },
        {
          "de": { "text": "Der Fortschritt sollte jetzt bei fast 100 Prozent sein. " },
          "en": { "text": "The progress should now be at almost 100 percent. " },
          "uk": { "text": "Прогрес тепер має бути майже 100 відсотків. " },
          "cs": { "text": "Pokrok by teď měl být skoro 100 procent. " },
          "ru": { "text": "Прогресс теперь должен быть почти 100 процентов. " }
        },
        {
          "de": { "text": "Wenn du das liest, hast du gewonnen.", "explanation": "Perfekt von 'gewinnen' ('hast ... gewonnen')." },
          "en": { "text": "If you are reading this, you have won.", "explanation": "Present perfect tense." },
          "uk": { "text": "Якщо ви це читаєте, ви перемогли.", "explanation": "Минулий завершений час." },
          "cs": { "text": "Jestli tohle čteš, vyhrál jsi.", "explanation": "Minulý čas." },
          "ru": { "text": "Если вы это читаете, вы победили.", "explanation": "Прошедшее время." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Vielen Dank fürs Lesen dieses absurden Textes." },
          "en": { "text": "Thank you for reading this absurd text." },
          "uk": { "text": "Дякую за читання цього абсурдного тексту." },
          "cs": { "text": "Děkuji za přečtení tohoto absurdního textu." },
          "ru": { "text": "Спасибо за чтение этого абсурдного текста." }
        }
      ]
    }
  ]
}
