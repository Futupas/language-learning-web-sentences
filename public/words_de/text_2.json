          "de": { "text": "Das ist meine Familie.", "explanation": "Demonstrativpronomen 'das'." },
          "en": { "text": "This is my family.", "explanation": "Demonstrative pronoun 'das'." },
          "uk": { "text": "Це моя сім'я.", "explanation": "Вказівний займенник 'das'." },
          "cs": { "text": "Toto je moje rodina.", "explanation": "Ukazovací zájmeno." },
          "ru": { "text": "Это моя семья.", "explanation": "Указательное местоимение." }
        }
      ]
    },
    {
      "type": "p",
      "segments": [
        {
          "de": { "text": "Mein Vater ", "explanation": "Nominativ, männlich." },
          "en": { "text": "My father ", "explanation": "Nominative, masculine." },
          "uk": { "text": "Мій батько ", "explanation": "Називний відмінок, чоловічий рід." },
          "cs": { "text": "Můj otec ", "explanation": "Nominativ, mužský rod." },
          "ru": { "text": "Мой отец ", "explanation": "Именительный падеж, мужской род." }
        },
        {
          "de": { "text": "heißt Peter ", "explanation": "Das Verb 'heißen' (to be called)." },
          "en": { "text": "is named Peter ", "explanation": "The verb 'heißen' (to be called)." },
          "uk": { "text": "називається Петер ", "explanation": "Дієслово 'heißen'." },
          "cs": { "text": "se jmenuje Petr ", "explanation": "Sloveso 'jmenovat se'." },
          "ru": { "text": "зовут Петер ", "explanation": "Глагол 'heißen'." }
        },
        {
          "de": { "text": "und er arbeitet als Arzt.", "explanation": "Berufsbezeichnungen stehen im Deutschen ohne Artikel." },
          "en": { "text": "and he works as a doctor.", "explanation": "Profession titles in German don't take articles." },
          "uk": { "text": "і він працює лікарем.", "explanation": "Назви професій вживаються без артикля." },
          "cs": { "text": "a pracuje jako lékař.", "explanation": "Názvy povolání se uvádějí bez členu." },
          "ru": { "text": "и он работает врачом.", "explanation": "Названия профессий используются без артикля." }
        }
      ]
    }
